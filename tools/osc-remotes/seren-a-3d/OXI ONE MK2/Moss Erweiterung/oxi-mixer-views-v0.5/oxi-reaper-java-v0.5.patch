+    {
+        return this.isOffline;
+    }
+
+
+    /**
+     * Set the offline state.
+     *
+     * @param isOffline True if offline
+     */
+    public void setOffline (final boolean isOffline)
+    {
+        this.isOffline = isOffline;
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    public void toggleOffline ()
+    {
+        this.sendFxOSC ("offline", this.isOffline ? 0 : 1);
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    public boolean isWindowOpen ()
+    {
+        return this.isWindowOpen;
+    }
+
+
+    /**
+     * Set the window state.
+     *
+     * @param isWindowOpen True if the window of the FX is open
+     */
+    public void setWindowOpen (final boolean isWindowOpen)
+    {
+        this.isWindowOpen = isWindowOpen;
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    public void toggleWindowOpen ()
+    {
+        this.sendFxOSC ("window", this.isWindowOpen ? 0 : 1);
+    }
+
+
+    /**
+     * Selects the track and makes the FX the cursor device.
+     */
+    @Override
+    public void select ()
+    {
+        this.sendFxOSC ("select", 1);
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    public void remove ()
+    {
+        this.sendFxOSC ("remove");
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    public void duplicate ()
+    {
+        this.sendFxOSC ("duplicate");
+    }
+
+
+    private void sendFxOSC (final String command, final int value)
+    {
+        if (this.doesExist ())
+            this.sender.processIntArg (Processor.TRACK, this.createFxCommand (command), value);
+    }
+
+
+    private void sendFxOSC (final String command)
+    {
+        if (this.doesExist ())
+            this.sender.processNoArg (Processor.TRACK, this.createFxCommand (command));
+    }
+
+
+    private String createFxCommand (final String command)
+    {
+        return this.track.getPosition () + "/fx/" + this.getPosition () + "/" + command;
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    protected Processor getProcessor ()
+    {
+        return Processor.TRACK;
+    }
+
+
+    private static String removeTypeAndManufacturer (final String name)
+    {
+        if (name == null)
+            return "";
+
+        final Matcher matcher = PATTERN_DEVICE_NAME.matcher (name);
+        if (!matcher.matches ())
+            return name;
+
+        // Group 1 is type, Group 3 is company
+        return matcher.group (2);
+    }
+}
