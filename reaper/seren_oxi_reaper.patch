@@ -74,6 +74,28 @@
 
     /** {@inheritDoc} */
     @Override
+    public void drawGrid ()
+    {
+        this.updateClipColors ();
+        super.drawGrid ();
+    }
+
+
+    /**
+     * Apply the configured clip colors.
+     */
+    private void updateClipColors ()
+    {
+        final OxiOneConfiguration config = this.surface.getConfiguration ();
