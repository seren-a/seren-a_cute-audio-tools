diff --git a/reaper_drivenbymoss/Track.cpp b/reaper_drivenbymoss/Track.cpp
index 43d6c74..743ada8 100644
--- a/reaper_drivenbymoss/Track.cpp
+++ b/reaper_drivenbymoss/Track.cpp
@@ -114,6 +114,56 @@ void Track::CollectData(std::ostringstream& ss, ReaProject* project, MediaTrack*
 }
 
 
+/**
+ * Collect the (changed) data of all FX of the track: name, bypass, offline and window state.
+ *
+ * @param ss The stream where to append the formatted data
+ * @param track The track
+ * @param trackIndex The index of the track
+ * @param slowUpdate If true, also update the names
+ * @param dump If true all data is collected not only the changed one since the last call
+ */
+void Track::CollectFxData(std::ostringstream& ss, MediaTrack* track, int trackIndex, const bool& slowUpdate, const bool& dump)
+{
+	std::ostringstream das;
+	das << "/track/" << trackIndex << "/fx/";
+	const std::string fxAddress = das.str();
+
+	const int count = TrackFX_GetCount(track);
+	const bool countChanged = count != this->fxCount;
+	this->fxCount = Collectors::CollectIntValue(ss, fxAddress + "count", this->fxCount, count, dump);
+
+	if (gsl::narrow_cast<int>(this->fxs.size()) < count)
+		this->fxs.resize(count);
+
+	constexpr int LENGTH = 100;
+	std::string strBuffer(LENGTH, 0);
+	char* strBufferPointer = &*strBuffer.begin();
+
+	for (int index = 0; index < count; index++)
+	{
+		TrackFx& fx = this->fxs.at(index);
+
+		std::ostringstream ias;
+		ias << fxAddress << index << "/";
+		const std::string address = ias.str();
+
+		if (slowUpdate || countChanged || dump)
+		{
+			const bool result = TrackFX_GetFXName(track, index, strBufferPointer, LENGTH);
+			fx.name = Collectors::CollectStringValue(ss, address + "name", fx.name, result ? std::string(strBufferPointer) : "", dump);
+		}
+		fx.bypass = Collectors::CollectIntValue(ss, address + "bypass", fx.bypass, TrackFX_GetEnabled(track, index) ? 0 : 1, dump);
+		fx.offline = Collectors::CollectIntValue(ss, address + "offline", fx.offline, TrackFX_GetOffline(track, index) ? 1 : 0, dump);
+		fx.window = Collectors::CollectIntValue(ss, address + "window", fx.window, TrackFX_GetOpen(track, index) ? 1 : 0, dump);
+	}
+
+	// Reset the cached data of removed FX to force sending them again if they re-appear
+	for (int index = count; index < gsl::narrow_cast<int>(this->fxs.size()); index++)
+		this->fxs.at(index) = TrackFx();
+}
+
