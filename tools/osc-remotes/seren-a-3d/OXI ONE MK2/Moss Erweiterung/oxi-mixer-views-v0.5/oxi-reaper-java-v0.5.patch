+
+package de.mossgrabers.reaper.framework.daw.data.bank;
+
+import java.util.List;
+import java.util.Optional;
+
+import de.mossgrabers.framework.controller.color.ColorEx;
+import de.mossgrabers.framework.daw.data.IDeviceMetadata;
+import de.mossgrabers.framework.daw.data.ITrack;
+import de.mossgrabers.framework.daw.resource.ChannelType;
+import de.mossgrabers.framework.observer.INoteObserver;
+import de.mossgrabers.reaper.framework.daw.DataSetupEx;
+
+
+/**
+ * A track bank with a different page size than the main track bank. It shows the same tracks (the
+ * flat track list or the current folder) as the main track bank but has its own scroll position.
+ * Since the backend sends the data of all tracks, no extra data needs to be requested.
+ *
+ * @author Jürgen Moßgraber
+ */
+public class AdditionalTrackBankImpl extends AbstractTrackBankImpl
+{
+    private final TrackBankImpl mainTrackBank;
+
+
+    /**
+     * Constructor.
+     *
+     * @param dataSetup Some configuration variables
+     * @param mainTrackBank The main track bank which provides the tracks
+     * @param numTracks The number of tracks in a page of this bank
+     */
+    public AdditionalTrackBankImpl (final DataSetupEx dataSetup, final TrackBankImpl mainTrackBank, final int numTracks)
+    {
+        super (dataSetup, null, numTracks, mainTrackBank.getSceneBank (), 0, 0, 0);
+
+        this.mainTrackBank = mainTrackBank;
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    public ITrack getItem (final int index)
+    {
+        final int position = this.bankOffset + index;
+        if (position < 0 || position >= this.getItemCount ())
+            return this.emptyItem;
+        return this.mainTrackBank.getListItem (position);
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    public int getItemCount ()
+    {
+        return this.mainTrackBank.getItemCount ();
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    public Optional<ITrack> getSelectedItem ()
+    {
+        for (int i = 0; i < this.getPageSize (); i++)
+        {
+            final ITrack track = this.getItem (i);
+            if (track.isSelected ())
+                return Optional.of (track);
+        }
+        return Optional.empty ();
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    public boolean canEditSend (final int sendIndex)
+    {
+        return this.mainTrackBank.canEditSend (sendIndex);
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    public String getEditSendName (final int sendIndex)
+    {
+        return this.mainTrackBank.getEditSendName (sendIndex);
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    public void selectParent ()
+    {
+        this.mainTrackBank.selectParent ();
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    public boolean hasParent ()
+    {
+        return this.mainTrackBank.hasParent ();
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    public void addChannel (final ChannelType type, final String name, final ColorEx color)
+    {
+        this.mainTrackBank.addChannel (type, name, color);
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    public void addChannel (final ChannelType type, final String name, final List<IDeviceMetadata> devices)
+    {
+        this.mainTrackBank.addChannel (type, name, devices);
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    public void addNoteObserver (final INoteObserver observer)
+    {
+        // Not supported, use the main track bank
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    public void setSkipDisabledItems (final boolean shouldSkip)
+    {
+        // Uses the setting of the main track bank
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    public void enableObservers (final boolean enable)
+    {
+        // Must not disable the track updates, which are shared with the main track bank
+    }
+
+
+    /**
+     * Scrolls the bank locally to the exact position (like in Bitwig), does not select a track.
+     *
+     * @param position The position of the first track to display
+     * @param adjustPage Ignored
+     */
+    @Override
+    public void scrollTo (final int position, final boolean adjustPage)
+    {
+        if (position >= 0 && position < this.getItemCount ())
+            this.setBankOffset (position);
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    protected void scrollPageBackwards ()
+    {
+        this.setBankOffset (this.bankOffset - this.getPageSize ());
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    protected void scrollPageForwards ()
+    {
+        this.setBankOffset (this.bankOffset + this.getPageSize ());
+    }
+}
