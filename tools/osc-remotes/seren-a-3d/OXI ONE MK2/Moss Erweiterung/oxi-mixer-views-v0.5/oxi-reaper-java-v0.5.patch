+     * @param value The value
+     */
+    private void parseTrackFxValue (final TrackImpl track, final Queue<String> parts, final String value)
+    {
+        final TrackFxBankImpl fxBank = track.getFxBank ();
+        final String part = parts.poll ();
+        if (TAG_COUNT.equals (part))
+        {
+            fxBank.setItemCount (Integer.parseInt (value));
+            return;
+        }
+
+        try
+        {
+            final TrackFxImpl fx = fxBank.getUnpagedItem (Integer.parseInt (part));
+            fx.setExists (true);
+            final String command = parts.poll ();
+            switch (command)
+            {
+                case TAG_NAME:
+                    fx.setName (value);
+                    break;
+                case "bypass":
+                    fx.setEnabled (Double.parseDouble (value) == 0);
+                    break;
+                case "offline":
+                    fx.setOffline (Double.parseDouble (value) > 0);
+                    break;
+                case "window":
+                    fx.setWindowOpen (Double.parseDouble (value) > 0);
+                    break;
+                default:
+                    this.host.error ("Unhandled Track FX Parameter: " + command);
+                    break;
+            }
+        }
+        catch (final NumberFormatException ex)
+        {
+            this.host.error ("Unhandled Track FX command: " + part);
+        }
+    }
