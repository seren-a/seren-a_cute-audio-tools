diff --git a/reaper_drivenbymoss/TrackProcessor.cpp b/reaper_drivenbymoss/TrackProcessor.cpp
index cc704a2..42ce345 100644
--- a/reaper_drivenbymoss/TrackProcessor.cpp
+++ b/reaper_drivenbymoss/TrackProcessor.cpp
@@ -42,6 +42,36 @@ void TrackProcessor::Process(std::deque<std::string>& path) noexcept
 
 	const char* cmd = SafeGet(path, 1);
 
+	// FX commands without a value: /track/{index}/fx/{fxIndex}/remove|duplicate
+	if (std::strcmp(cmd, "fx") == 0)
+	{
+		if (path.size() < 4)
+			return;
+		const int fx = atoi(SafeGet(path, 2));
+		if (fx < 0 || fx >= TrackFX_GetCount(track))
+			return;
+		const char* fxCmd = SafeGet(path, 3);
+
+		if (std::strcmp(fxCmd, "remove") == 0)
+		{
+			PreventUIRefresh(1);
+			Undo_BeginBlock2(project);
+			TrackFX_Delete(track, fx);
+			Undo_EndBlock2(project, "Delete device", UNDO_STATE_FX);
+			PreventUIRefresh(-1);
+			return;
+		}
+
+		if (std::strcmp(fxCmd, "duplicate") == 0)
+		{
+			Undo_BeginBlock2(project);
+			TrackFX_CopyToTrack(track, fx, track, fx + 1, false);
+			Undo_EndBlock2(project, "Duplicate device", UNDO_STATE_FX);
+			return;
+		}
+		return;
+	}
+
 	if (std::strcmp(cmd, "scrollto") == 0)
 	{
 		SetOnlyTrackSelected(track);
@@ -190,6 +220,58 @@ void TrackProcessor::Process(std::deque<std::string>& path, int value)
 
 	const char* cmd = SafeGet(path, 1);
 
+	// FX commands with a value: /track/{index}/fx/{fxIndex}/select|bypass|offline|window {value}
+	if (std::strcmp(cmd, "fx") == 0)
+	{
+		if (path.size() < 4)
+			return;
+		const int fx = atoi(SafeGet(path, 2));
+		if (fx < 0 || fx >= TrackFX_GetCount(track))
+			return;
+		const char* fxCmd = SafeGet(path, 3);
+
+		if (std::strcmp(fxCmd, "select") == 0)
+		{
+			// Select the track and make the FX the cursor device. Unlike Model::SetDeviceSelection
+			// a floating window is not opened but if the FX chain window is visible, it shows the FX
+			// (otherwise the focused FX of the chain would immediately reset the selection)
+			SetOnlyTrackSelected(track);
+			ScrollTrackIntoView(track);
+			this->model.deviceSelected = fx % this->model.DEVICE_BANK_SIZE;
+			this->model.deviceBankOffset = fx / this->model.DEVICE_BANK_SIZE * this->model.DEVICE_BANK_SIZE;
+			if (this->model.deviceExpanded)
+			{
+				const int effectVisibleInChain = TrackFX_GetChainVisible(track);
+				if (effectVisibleInChain != -1 && effectVisibleInChain != fx)
+					TrackFX_SetOpen(track, fx, true);
+			}
+			return;
+		}
+
+		if (std::strcmp(fxCmd, "bypass") == 0)
+		{
+			Undo_BeginBlock2(project);
+			TrackFX_SetEnabled(track, fx, value > 0 ? false : true);
+			Undo_EndBlock2(project, "Toggle device bypass", UNDO_STATE_FX);
+			return;
+		}
+
+		if (std::strcmp(fxCmd, "offline") == 0)
+		{
+			Undo_BeginBlock2(project);
+			TrackFX_SetOffline(track, fx, value > 0);
+			Undo_EndBlock2(project, "Toggle device offline", UNDO_STATE_FX);
+			return;
+		}
+
+		if (std::strcmp(fxCmd, "window") == 0)
+		{
+			TrackFX_SetOpen(track, fx, value > 0);
+			return;
+		}
+		return;
+	}
+
 	if (std::strcmp(cmd, "select") == 0)
 	{
 		SetOnlyTrackSelected(track);
