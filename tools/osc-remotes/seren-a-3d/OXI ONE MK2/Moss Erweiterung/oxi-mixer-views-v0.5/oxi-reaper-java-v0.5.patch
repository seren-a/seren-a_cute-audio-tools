+// Written by Jürgen Moßgraber - mossgrabers.de
+// (c) 2017-2026
+// Licensed under LGPLv3 - http://www.gnu.org/licenses/lgpl-3.0.txt
+
+package de.mossgrabers.reaper.framework.daw.data.bank;
+
+import de.mossgrabers.framework.daw.data.IDevice;
+import de.mossgrabers.framework.daw.data.bank.IDeviceBank;
+import de.mossgrabers.reaper.communication.Processor;
+import de.mossgrabers.reaper.framework.daw.DataSetupEx;
+import de.mossgrabers.reaper.framework.daw.data.TrackFxImpl;
+import de.mossgrabers.reaper.framework.daw.data.TrackImpl;
+
+
+/**
+ * The FX of a track (which is not necessarily the selected track). Scrolling is only done locally.
+ * The backend sends the data only if the "trackfx" updates are enabled, which is done with
+ * enableObservers.
+ *
+ * @author Jürgen Moßgraber
+ */
+public class TrackFxBankImpl extends AbstractPagedBankImpl<TrackFxImpl, IDevice> implements IDeviceBank
+{
+    /** The page size of the FX bank of a track. */
+    public static final int PAGE_SIZE = 8;
+
+    private final TrackImpl track;
+
+
+    /**
+     * Constructor.
+     *
+     * @param dataSetup Some configuration variables
+     * @param track The track to which the FX belong, null for an empty bank
+     * @param numDevices The number of devices in a page
+     */
+    public TrackFxBankImpl (final DataSetupEx dataSetup, final TrackImpl track, final int numDevices)
+    {
+        super (dataSetup, numDevices, new TrackFxImpl (dataSetup, null, 0));
+
+        this.track = track;
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    protected TrackFxImpl createItem (final int position)
+    {
+        return new TrackFxImpl (this.dataSetup, this.track, position);
+    }
+
+
+    /** {@inheritDoc} */
+    @Override
+    public void enableObservers (final boolean enable)
+    {
+        // Enables/disables the FX data of all tracks
+        if (this.sender != null)
+            this.sender.enableUpdates (Processor.TRACKFX, enable);
+    }
+
+
+    /**
+     * Set the number of FX. Keeps the scroll position (which can be on any FX, not only at the
+     * start of a page) unless it is out of range.
+     *
+     * @param itemCount The number of FX
+     */
+    @Override
+    public void setItemCount (final int itemCount)
+    {
+        this.itemCount = itemCount;
+        if (this.bankOffset >= itemCount)
+            this.setBankOffset (Math.max (0, itemCount - 1));
+    }
+
+
+    /**
+     * Scrolls to the exact position (like in Bitwig), the page is never adjusted since the plugin
+     * mixer scrolls device by device.
+     *
+     * @param position The position of the first device to display
+     * @param adjustPage Ignored
+     */
+    @Override
+    public void scrollTo (final int position, final boolean adjustPage)
+    {
+        this.setBankOffset (position);
+    }
+}
