+    /**
+     * Get a track of the current track list (the flat list or the children of the current folder)
+     * independent of the current page.
+     *
+     * @param position The position in the track list
+     * @return The track or an empty track if the position is out of range
+     */
+    public ITrack getListItem (final int position)
+    {
+        this.recalcTrackList ();
+
+        if (this.hasFlatTrackList)
+            return position >= 0 && position < this.flatTracks.size () ? this.flatTracks.get (position) : this.emptyItem;
+
+        final List<TreeNode<TrackImpl>> children = this.currentFolder.getChildren ();
+        return position >= 0 && position < children.size () ? children.get (position).getData () : this.emptyItem;
+    }
